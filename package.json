{
  "name": "peruandes-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/site"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:site": "npm run dev --workspace @peruandes/site",
    "build:site": "npm run build --workspace @peruandes/site",
    "check:site": "npm run check --workspace @peruandes/site",
    "build:all": "npm run build && npm run build:site",
    "test": "node tests/database.mjs",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" package.json next.config.ts eslint.config.mjs tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  }
}
