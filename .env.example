# Copiar a .env.local y completar con los valores del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor; necesaria para crear cuentas de vendedoras desde el panel.
# Usar clave secret o service_role. Nunca anteponer NEXT_PUBLIC_ a esta variable.
SUPABASE_SECRET_KEY=
